# 构建产物（可随时用脚本重新生成）
dist/
apk-puzzle/build/

# 第三方 Android SDK（体积数 GB，可用 sdkmanager 重装；见 README）
android-sdk/

# 本地开发证书（node make-cert.mjs 可重新生成，私钥不入库）
cert/

# 本地签名密钥与密码
*.keystore
apk-puzzle/keystore.pass

# 测试截图与日志
test/preview-*.png
test/*.log

# 依赖与临时文件
node_modules/
*.tmp
.DS_Store
Thumbs.db

# 临时脚本/会话日志（工作区杂项）
.tmp-*
